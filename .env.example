# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database (use a dedicated account with only SELECT, INSERT, UPDATE, DELETE) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_app
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=lms_database
DB_POOL_SIZE=5

# --- App ---
APP_ENV=development          # development | production
LOG_LEVEL=INFO
LOG_DIR=logs
PAGE_SIZE=25                 # rows per page in tables
CACHE_TTL_SECONDS=30         # how long lookups/reports are cached (writes clear the cache)

# --- Authentication ---
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Grading scheme: the three maxima add up to the total marks (default 20 + 20 + 60 = 100) ---
GRADE_MAX_ASSIGNMENT=20
GRADE_MAX_QUIZ=20
GRADE_MAX_FINAL=60
